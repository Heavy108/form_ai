# ==========================================
# Root .gitignore (Frontend & Backend Monorepo)
# ==========================================

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt
# Allow committing example environment files
!.env.example
!.env.template

# ------------------------------------------
# Python / Backend
# ------------------------------------------
# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
wheels/
*.installed.cfg

# Model Weights, Large Checkpoints & ML Artifacts
*.pt
*.pth
*.bin
*.onnx
*.weights
*.safetensors
runs/
weights/
.cache/
checkpoints/

# Unit test / coverage / linting caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.pyre/

# Jupyter Notebooks
.ipynb_checkpoints/

# ------------------------------------------
# Node / Next.js / Frontend
# ------------------------------------------
# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Output
.next/
out/

# TypeScript build cache
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# Test coverage
coverage/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ------------------------------------------
# Operating System & Editor Files
# ------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains (IntelliJ, PyCharm, WebStorm, etc.)
.idea/

# Temporary / swap files
*.swp
*.swo
*~

